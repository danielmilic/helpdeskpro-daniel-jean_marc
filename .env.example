# Copier ce fichier en .env et adapter les valeurs. Ne jamais versionner .env.

# Base de données (utilisée par l'API et le worker)
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=helpdesk
DATABASE_URL=postgres://helpdesk:changez-moi@db:5432/helpdesk

# API
API_PORT=3000
LOG_LEVEL=info

# Worker
WORKER_INTERVAL_MS=10000

# Déploiement (chapitre 5) : image publiée par le pipeline
GH_OWNER=mon-organisation
IMAGE_TAG=latest
